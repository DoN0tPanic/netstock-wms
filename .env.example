# --- Database ---
# POSTGRES_USER è il ruolo owner/superuser usato SOLO per le migration (Alembic).
# netstock_app è il ruolo runtime dell'applicazione: privilegi limitati, niente
# UPDATE/DELETE/TRUNCATE su stock_movements e audit_log (§4.2, seconda barriera
# di append-only oltre ai trigger).
POSTGRES_DB=netstock
POSTGRES_USER=netstock
POSTGRES_PASSWORD=            # generare: openssl rand -base64 32
APP_DB_PASSWORD=              # generare: openssl rand -base64 32

# --- Applicazione ---
SECRET_KEY=                   # generare: openssl rand -hex 32
SITE_ADDRESS=netstock.local
ADMIN_EMAIL=itops@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=               # cambiato obbligatoriamente al primo accesso
LOG_LEVEL=INFO
TZ=Europe/Rome

# --- Estrazione da immagine ---
EXTRACT_ENABLED=true          # false = gestionale senza AI, funziona identico
EXTRACT_MODE=text             # text | vision
# Scaricalo con `make ollama-pull`. qwen3:4b (Apache-2.0) legge correttamente la
# tabella di una bolla; modelli piu' piccoli confondono le colonne.
EXTRACT_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://ollama:11434
EXTRACT_ALLOW_HEIC=false      # true richiede ADR sulla dipendenza LGPL
EXTRACTION_LOG_RETENTION_DAYS=90

# --- Osservabilità ---
METRICS_ENABLED=false

# --- Backup ---
# Dove finisce una seconda copia del dump. Senza, l'unica copia sta sullo
# stesso disco del database che dovrebbe proteggere: basta a rimediare a un
# errore, non a un disco che muore o a una VM che sparisce.
# Accetta un percorso montato (/mnt/nas/netstock) o un bersaglio rsync
# (utente@nas:/volume1/backup/netstock/). Se la copia non riesce, il backup
# risulta fallito — altrimenti `systemctl status` direbbe verde per mesi.
BACKUP_REMOTE=                # facoltativa: senza, la copia resta su questo disco
# La domenica il dump appena fatto viene ripristinato per finta in un database
# usa e getta e le righe si contano: è la differenza fra «abbiamo i backup» e
# «sappiamo che i backup tornano». 0 per saltarla.
BACKUP_RESTORE_TEST=1
