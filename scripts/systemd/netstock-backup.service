[Unit]
Description=Backup del database NetStock
Documentation=file:%h/netstock/README.md
# Il backup passa da `docker compose exec`: senza Docker non c'è niente da
# copiare, e un tentativo a vuoto scriverebbe un fallimento ogni notte.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=__UTENTE__
WorkingDirectory=__REPO__
ExecStart=__REPO__/scripts/backup.sh
# Il dump è I/O puro e non deve rallentare chi sta lavorando in magazzino.
Nice=10
IOSchedulingClass=idle
